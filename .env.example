# Trackfolio — copy to .env.local and fill in the values you have.
# The app boots with whatever providers are actually configured.

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-32-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth (at least one provider) ------------------------------------------
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="Trackfolio <onboarding@resend.dev>"

# --- Optional --------------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Required when the Anthropic key is identity-linked / multi-workspace (Console → Settings → Workspaces).
ANTHROPIC_WORKSPACE_ID=""
# Optional. Default prefers Anthropic when both keys exist; "openai" skips Anthropic.
AI_PREFERRED_PROVIDER=""
BLOB_READ_WRITE_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
CRON_SECRET=""
LATEX_COMPILER_URL="https://texlive.net/cgi-bin/latexcgi"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
